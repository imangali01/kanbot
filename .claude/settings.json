{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(*)",
      "Bash(npx vercel deploy:*)",
      "Bash(vercel deploy:*)",
      "Bash(git push:*)",
      "PowerShell(*)",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Skill",
      "Agent",
      "Artifact"
    ],
    "ask": [],
    "deny": [
      "Read(./.env)",
      "Bash(git add .env*)",
      "Bash(git add -f .env*)"
    ]
  }
}
