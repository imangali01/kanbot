{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm ls*)",
      "Bash(npx vitest*)",
      "Bash(npx tsc*)",
      "Bash(npx next *)",
      "Bash(npx drizzle-kit *)",
      "Bash(npx vercel whoami*)",
      "Bash(npx vercel ls*)",
      "Bash(npx vercel inspect*)",
      "Bash(npx vercel logs*)",
      "Bash(npx vercel env ls*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch*)",
      "Bash(git checkout *)",
      "Bash(curl -s https://api.telegram.org/*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(npx vercel deploy*)",
      "Bash(npx vercel --prod*)",
      "Bash(npx vercel env add*)",
      "Bash(npx vercel env rm*)",
      "Bash(npm run db:migrate*)",
      "Bash(npm run webhook:set*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Bash(git add .env*)",
      "Bash(git add -f .env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  }
}
